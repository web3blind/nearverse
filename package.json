{
  "name": "nearverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=1",
    "test:icons": "node --max-old-space-size=128 scripts/check-material-icons.mjs",
    "server": "tsx server/index.ts",
    "preview": "tsx server/index.ts preview",
    "test:browser": "node scripts/browser-qa.mjs"
  },
  "dependencies": {
    "@aurora-is-near/intents-swap-widget": "7.29.0",
    "@aurora-is-near/intents-swap-widget-standalone": "7.29.0",
    "@hot-labs/near-connect": "0.6.11",
    "@material-symbols-svg/react-rounded": "0.1.22",
    "@near-js/crypto": "2.5.1",
    "@near-js/providers": "2.5.1",
    "@walletconnect/sign-client": "2.26.0",
    "better-sqlite3": "12.4.1",
    "borsh": "2.0.0",
    "express": "5.1.0",
    "idb": "8.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@hot-labs/omni-sdk@2.24.3": {
      "@solana/web3.js": "1.68.2"
    },
    "ethers@6.15.0": {
      "ws": "8.21.0"
    }
  }
}
